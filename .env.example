# Copy to .env and fill in. This file holds IDs and settings only.
# Secrets (tokens and keys) go in ./secrets/, never here. See README.md.

# ======================== Shared by every server ========================

# Docker network that Nginx Proxy Manager is attached to.
NPM_NETWORK=npm_default

LOG_LEVEL=info

# ============================ Server settings ============================
#
# For ONE server, fill in the settings below.
#
# For SEVERAL servers, give each one its own file in config/servers/ instead,
# such as config/servers/friends.toml (copy config/settings.example.toml), and
# delete these lines from your .env. The bot refuses to start if both are
# set, so it's never unclear which one applies.

# Discord IDs (Settings → Advanced → Developer Mode, then right-click → Copy ID)
GUILD_ID=
VERIFIED_ROLE_ID=
MOD_CHANNEL_ID=

# Roles the bot treats as admins, comma-separated. Members holding any of
# them (plus the server owner) can use /verify-member, /verification-panel
# and the Approve/Deny buttons. Discord permissions like Administrator
# don't count on their own.
ADMIN_ROLE_IDS=

# How people verify:
#   captcha: image code inside Discord.
#   web:     Discord login on your site, plus alt detection by (hashed) IP.
VERIFY_METHOD=captcha

# What happens to flagged users (young account, sharing a network with
# another account, or on a VPN):
#   review: hold until a moderator clicks Approve or Deny (recommended)
#   allow:  verify them anyway but alert moderators
FLAGGED_ACTION=review

# Accounts younger than this are flagged. 0 turns the check off.
MIN_ACCOUNT_AGE_DAYS=7

# Web method only: hold members who verify through a known VPN for review.
FLAG_VPN=true

# Web method only: days to keep IP hashes before deleting them.
IP_RETENTION_DAYS=180

# Raid protection: if this many people try to verify within this many
# minutes, everyone verifying is held, with one raid alert for moderators
# instead of a message each. RAID_THRESHOLD=0 turns it off.
RAID_THRESHOLD=10
RAID_WINDOW_MINUTES=5

# Only if you used HollowWarden before multi-server support AND now
# configure several servers: the guild_id of the server the bot used to run
# in, so its existing data (alt history, pending reviews) goes to the right
# server. With one server this is worked out automatically.
# LEGACY_DATA_GUILD_ID=

# ============ Web verification (shared by every server using it) ============
# Only needed if at least one server uses the web method.

# The public URL Nginx Proxy Manager serves the bot on (must be https).
PUBLIC_BASE_URL=https://verify.example.com

# OAuth2 → Client ID in the Discord developer portal.
DISCORD_CLIENT_ID=

# Who's allowed to tell the bot a visitor's real IP: the subnet of the
# NPM_NETWORK Docker network
# (docker network inspect npm_default --format '{{(index .IPAM.Config 0).Subnet}}').
TRUSTED_PROXIES=172.18.0.0/16

# The header carrying the visitor's IP. See README "Getting the real IP".
#   X-Real-IP          Cloudflare DNS-only (grey cloud), or NPM restoring real IPs from Cloudflare
#   CF-Connecting-IP   Cloudflare proxied (orange cloud) AND your firewall only accepts Cloudflare
CLIENT_IP_HEADER=X-Real-IP

# Where the VPN list comes from (comma-separated https URLs). One list is
# shared; each server decides whether to act on it (flag_vpn). The default is
# X4BNet's known-VPN list, which is updated regularly. Their broader
# "datacenter" list (output/datacenter/ipv4.txt) catches more, but also flags
# some home internet customers, so it isn't recommended.
# VPN_LIST_URLS=https://raw.githubusercontent.com/X4BNet/lists_vpn/main/output/vpn/ipv4.txt
