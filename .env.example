# Copy to .env and fill in. This file holds IDs and settings only.
# Secrets (tokens and keys) go in ./secrets/, never here. See README.md.

# Docker network that Nginx Proxy Manager is attached to.
NPM_NETWORK=npm_default

# Discord IDs (Settings → Advanced → Developer Mode, then right-click → Copy ID)
GUILD_ID=
VERIFIED_ROLE_ID=
MOD_CHANNEL_ID=

# How people verify:
#   captcha: image code inside Discord. No web server runs and nothing is exposed.
#   web:     Discord login on your site, plus alt detection by (hashed) IP.
VERIFY_METHOD=captcha

# What happens to flagged users (young account, or sharing a network with
# another account):
#   review: hold until a moderator clicks Approve or Deny (recommended)
#   allow:  verify them anyway but alert moderators
FLAGGED_ACTION=review

# Accounts younger than this are flagged. 0 turns the check off.
MIN_ACCOUNT_AGE_DAYS=7

LOG_LEVEL=info

# ---- Only used when VERIFY_METHOD=web ----

# The public URL Nginx Proxy Manager serves the bot on (must be https).
PUBLIC_BASE_URL=https://verify.example.com

# OAuth2 → Client ID in the Discord developer portal.
DISCORD_CLIENT_ID=

# Who's allowed to tell the bot a visitor's real IP: the subnet of the
# NPM_NETWORK Docker network
# (docker network inspect npm_default --format '{{(index .IPAM.Config 0).Subnet}}').
TRUSTED_PROXIES=172.18.0.0/16

# The header carrying the visitor's IP. See README "Getting the real IP".
#   X-Real-IP          Cloudflare DNS-only (grey cloud), or NPM restoring real IPs from Cloudflare
#   CF-Connecting-IP   Cloudflare proxied (orange cloud) AND your firewall only accepts Cloudflare
CLIENT_IP_HEADER=X-Real-IP

# How long IP hashes are kept before being deleted automatically.
IP_RETENTION_DAYS=180
